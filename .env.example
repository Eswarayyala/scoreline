VITE_FIREBASE_DATABASE_URL=

# Optional live RAWG fallback for desk art. Prefer static packs under public/media.
# Do NOT set this in Vercel production long-term — it ships in the browser bundle.
# Rotate the key if it was ever deployed as VITE_RAWG_API_KEY.
VITE_RAWG_API_KEY=

# Firebase App Check (reCAPTCHA v3 site key — public). Pair with the secret in
# Firebase Console → App Check. Leave empty until keys exist; enforcement stays OFF until metrics are clean.
# https://console.cloud.google.com/security/recaptcha
# https://console.firebase.google.com/project/scoreliner/appcheck
VITE_RECAPTCHA_SITE_KEY=

# Local/CI only: App Check debug token (or "true" to prompt). Never set in production.
VITE_APPCHECK_DEBUG_TOKEN=

# Optional Discord invite (discord.gg / discord.com/invite). Soft CTA on game desks — no bot.
VITE_DISCORD_INVITE_URL=

# Live matrix orchestrator (node src/agents/data_orchestrator.js) — never commit real tokens
PANDASCORE_API_KEY=
LIQUIPEDIA_USER_AGENT=ScorelineBot/1.0 (https://www.grindinfo.xyz)

# Playwright dummy user (gitignored .env). Hits live by default.
PLAYWRIGHT_BASE_URL=https://www.grindinfo.xyz
PLAYWRIGHT_DUMMY_NAME=dummybot
PLAYWRIGHT_DUMMY_EMAIL=
PLAYWRIGHT_DUMMY_PASSWORD=
