VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_APPCHECK_SITE_KEY=
VITE_RAWG_API_KEY=

# Optional Discord invite (discord.gg / discord.com/invite). Soft CTA on game desks — no bot.
VITE_DISCORD_INVITE_URL=

# Live matrix orchestrator (node src/agents/data_orchestrator.js) — never commit real tokens
PANDASCORE_API_KEY=
LIQUIPEDIA_USER_AGENT=ScorelineBot/1.0 (https://www.grindinfo.xyz)

# Playwright dummy user (gitignored .env). Hits live by default.
PLAYWRIGHT_BASE_URL=https://www.grindinfo.xyz
PLAYWRIGHT_DUMMY_NAME=dummybot
PLAYWRIGHT_DUMMY_EMAIL=
PLAYWRIGHT_DUMMY_PASSWORD=

# Firebase Functions parameter (public Firebase Web API key for Auth REST proxy)
GRINDINFO_WEB_API_KEY=
