rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(t) {
      return request.auth != null && request.auth.uid == t.adminUserId;
    }
    function isAdmin(t) {
      return request.auth != null && (
        request.auth.uid == t.adminUserId ||
        (t.coAdminUserIds is list && request.auth.uid in t.coAdminUserIds)
      );
    }
    function parent(tid) {
      return get(/databases/$(database)/documents/tournaments/$(tid)).data;
    }
    function validPlayerProfile(data) {
      return data.keys().hasOnly([
               'displayName', 'games', 'region', 'language', 'style',
               'bio', 'discoverable', 'updatedAt'
             ])
             && data.keys().hasAll([
               'displayName', 'games', 'region', 'language', 'style',
               'bio', 'discoverable', 'updatedAt'
             ])
             && data.displayName is string
             && data.displayName.size() > 0
             && data.displayName.size() <= 40
             && data.games is list
             && data.games.size() <= 20
             && data.region is string
             && data.region.size() <= 60
             && data.language is string
             && data.language.size() <= 40
             && data.style is string
             && data.style.size() <= 60
             && data.bio is string
             && data.bio.size() <= 200
             && data.discoverable is bool
             && data.updatedAt is int;
    }

    match /tournaments/{tid} {
      allow read: if true;

      allow create: if request.auth != null
                    && request.resource.data.adminUserId == request.auth.uid
                    && request.resource.data.coAdminUserIds is list
                    && request.resource.data.coAdminUserIds.size() == 0;

      allow update: if isAdmin(resource.data)
                    && request.resource.data.adminUserId == resource.data.adminUserId
                    && (request.resource.data.coAdminUserIds == resource.data.coAdminUserIds
                        || isOwner(resource.data));

      allow delete: if isOwner(resource.data);

      match /teams/{id}   { allow read: if true; allow write: if isAdmin(parent(tid)); }
      match /matches/{id} { allow read: if true; allow write: if isAdmin(parent(tid)); }
      match /stats/{id}   { allow read: if true; allow write: if isAdmin(parent(tid)); }
    }

    match /players/{userId} {
      allow get: if request.auth != null
                 && (request.auth.uid == userId || resource.data.discoverable == true);

      allow list: if request.auth != null
                  && resource.data.discoverable == true;

      allow create, update: if request.auth != null
                            && request.auth.uid == userId
                            && validPlayerProfile(request.resource.data);

      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    match /scoreline/shared-data {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}