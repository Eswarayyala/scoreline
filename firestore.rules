rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSiteBanned() {
      return request.auth != null
        && exists(/databases/$(database)/documents/siteBans/$(request.auth.uid))
        && get(/databases/$(database)/documents/siteBans/$(request.auth.uid)).data.active == true;
    }
    function isSiteRestricted() {
      return request.auth != null
        && exists(/databases/$(database)/documents/siteBans/$(request.auth.uid))
        && get(/databases/$(database)/documents/siteBans/$(request.auth.uid)).data.restricted == true
        && get(/databases/$(database)/documents/siteBans/$(request.auth.uid)).data.active != true;
    }

    function isOwner(t) {
      return request.auth != null && !isSiteBanned() && request.auth.uid == t.adminUserId;
    }
    function isAdmin(t) {
      return request.auth != null && !isSiteBanned() && (
        request.auth.uid == t.adminUserId ||
        (t.coAdminUserIds is list && request.auth.uid in t.coAdminUserIds)
      );
    }
    function parent(tid) {
      return get(/databases/$(database)/documents/tournaments/$(tid)).data;
    }
    function isModerator() {
      return request.auth != null && !isSiteBanned()
        && exists(/databases/$(database)/documents/moderators/$(request.auth.uid))
        && get(/databases/$(database)/documents/moderators/$(request.auth.uid)).data.enabled == true;
    }
    function isSiteOwner() {
      return request.auth != null && !isSiteBanned()
        && exists(/databases/$(database)/documents/siteRoles/$(request.auth.uid))
        && get(/databases/$(database)/documents/siteRoles/$(request.auth.uid)).data.role == 'owner'
        && get(/databases/$(database)/documents/siteRoles/$(request.auth.uid)).data.enabled == true;
    }
    function isSiteSupport() {
      return request.auth != null && !isSiteBanned() && (
        (exists(/databases/$(database)/documents/siteRoles/$(request.auth.uid))
          && get(/databases/$(database)/documents/siteRoles/$(request.auth.uid)).data.role == 'support'
          && get(/databases/$(database)/documents/siteRoles/$(request.auth.uid)).data.enabled == true)
      );
    }
    function isSiteStaff() {
      return isSiteOwner() || isSiteSupport();
    }
    function isActiveSiteUser() {
      return request.auth != null && !isSiteBanned();
    }
    function canBrowsePublicData() {
      return request.auth == null || !isSiteBanned();
    }
    // Soft anti-spam on Spark (no Cloud Functions): new accounts wait briefly before posting.
    function accountAgeSeconds() {
      return request.time.toMillis() / 1000 - request.auth.token.auth_time;
    }
    function accountSettled() {
      return request.auth != null && accountAgeSeconds() >= 20;
    }
    function freshClientTimestamp(value) {
      return value is int
             && value <= request.time.toMillis() + 120000
             && value >= request.time.toMillis() - 300000;
    }
    function isSafeImageUrl(value, maxSize) {
      return value is string
             && value.size() > 0
             && value.size() <= maxSize
             && (value.matches('^https://.*')
                 || value.matches('^/media/.*')
                 || value.matches('^data:image/(png|jpeg|jpg|webp|gif);base64,.*'));
    }
    function isSafeAvatar(value) {
      return value is string
             && value.size() > 0
             && value.size() <= 2000
             && (value.size() <= 16
                 || isSafeImageUrl(value, 2000));
    }
    function isBlocked(firstUid, secondUid) {
      return exists(/databases/$(database)/documents/userBlocks/$(firstUid + '_' + secondUid))
        || exists(/databases/$(database)/documents/userBlocks/$(secondUid + '_' + firstUid));
    }
    function isAcceptedFriend(firstUid, secondUid) {
      return request.auth != null && firstUid != secondUid && !isBlocked(firstUid, secondUid)
        && ((exists(/databases/$(database)/documents/friendRequests/$(firstUid + '_' + secondUid))
             && get(/databases/$(database)/documents/friendRequests/$(firstUid + '_' + secondUid)).data.status == 'accepted')
            || (exists(/databases/$(database)/documents/friendRequests/$(secondUid + '_' + firstUid))
             && get(/databases/$(database)/documents/friendRequests/$(secondUid + '_' + firstUid)).data.status == 'accepted'));
    }
    function validSitePopup(data) {
      return data.keys().hasOnly(['title', 'message', 'type', 'enabled', 'frequency', 'minimumOnline', 'startsAt', 'endsAt', 'createdAt', 'updatedAt'])
        && data.keys().hasAll(['title', 'message', 'type', 'enabled', 'frequency', 'startsAt', 'endsAt', 'createdAt', 'updatedAt'])
        && data.title is string && data.title.size() > 0 && data.title.size() <= 100
        && data.message is string && data.message.size() > 0 && data.message.size() <= 1000
        && data.type in ['disclaimer', 'motivation']
        && data.enabled is bool
        && data.frequency in ['registration', 'session', 'random', 'hourly', 'busy']
        && (!data.keys().hasAny(['minimumOnline']) || (data.minimumOnline is int && data.minimumOnline >= 0 && data.minimumOnline <= 1000000))
        && data.startsAt is int && data.startsAt >= 0
        && data.endsAt is int && data.endsAt >= 0
        && (data.endsAt == 0 || data.startsAt == 0 || data.endsAt > data.startsAt)
        && data.createdAt is int
        && data.updatedAt is int;

    }
    function validPlayerProfile(data) {
      return data.keys().hasOnly([
               'displayName', 'games', 'region', 'language', 'languages', 'style', 'styles',
               'lookingFor', 'rank',
               'bio', 'discordHandle', 'avatar', 'discoverable', 'updatedAt', 'playerTag', 'handle',
               'usernameChanges'
             ])
             && data.keys().hasAll([
               'displayName', 'games', 'region', 'language', 'style',
               'bio', 'avatar', 'discoverable', 'updatedAt'
             ])
             && data.displayName is string
             && data.displayName.size() >= 3
             && data.displayName.size() <= 16
             && data.displayName.matches('^[A-Za-z0-9_]+$')
             && data.games is list
             && data.games.size() <= 20
             && data.region is string
             && data.region.size() <= 60
             && data.language is string
             && data.language.size() <= 40
             && data.style is string
             && data.style.size() <= 60
             && (!data.keys().hasAny(['languages']) || (data.languages is list && data.languages.size() <= 8))
             && (!data.keys().hasAny(['styles']) || (data.styles is list && data.styles.size() <= 8))
             && (!data.keys().hasAny(['lookingFor']) || (data.lookingFor is list && data.lookingFor.size() <= 6))
             && (!data.keys().hasAny(['rank']) || (data.rank is string && data.rank.size() <= 40))
             && data.bio is string
             && data.bio.size() <= 200
             && (!data.keys().hasAny(['discordHandle']) || (data.discordHandle is string && data.discordHandle.size() <= 40))
             && isSafeAvatar(data.avatar)
             && data.discoverable is bool
             && data.updatedAt is int
             && freshClientTimestamp(data.updatedAt)
             && (!data.keys().hasAny(['usernameChanges'])
                 || (data.usernameChanges is int && data.usernameChanges >= 0 && data.usernameChanges <= 1))
             && (!data.keys().hasAny(['playerTag']) || (data.playerTag is string && data.playerTag.matches('^[0-9]{4}$|^[0-9]{8}$')))
             && (!data.keys().hasAny(['handle'])
                 || (data.handle is string
                     && data.handle.size() <= 32
                     && data.keys().hasAny(['playerTag'])
                     && data.handle == data.displayName.lower() + '#' + data.playerTag));
    }

    // Initial name is free; after a tag exists, displayName may change once (usernameChanges 0 → 1).
    function playerUsernameChangeAllowed() {
      return !resource.data.keys().hasAny(['playerTag'])
             || request.resource.data.displayName == resource.data.displayName
             || (
               (!resource.data.keys().hasAny(['usernameChanges']) || resource.data.usernameChanges == 0)
               && request.resource.data.usernameChanges == 1
             );
    }

    function playerUsernameChangeCountConsistent() {
      return request.resource.data.displayName == resource.data.displayName
             ? (
               (!resource.data.keys().hasAny(['usernameChanges']) && !request.resource.data.keys().hasAny(['usernameChanges']))
               || (resource.data.keys().hasAny(['usernameChanges'])
                   && request.resource.data.keys().hasAny(['usernameChanges'])
                   && request.resource.data.usernameChanges == resource.data.usernameChanges)
             )
             : request.resource.data.usernameChanges == 1;
    }

    function validReport(data) {
      return data.keys().hasOnly([
               'reporterId', 'targetType', 'targetId', 'targetName',
               'reason', 'details', 'status', 'createdAt'
             ])
             && data.reporterId == request.auth.uid
             && data.targetType in ['player', 'tournament']
             && data.targetId is string
             && data.targetId.size() > 0
             && data.targetId.size() <= 128
             && data.targetName is string
             && data.targetName.size() <= 120
             && data.reason in ['Abuse or harassment', 'Scam or fraud', 'Inappropriate content', 'Other']
             && data.details is string
             && data.details.size() <= 1000
             && data.status == 'submitted'
             && data.createdAt is int;
    }

    function validBlogPost(data) {
      return data.keys().hasOnly([
               'title', 'game', 'content', 'source', 'authorId', 'authorName', 'anonymous',
               'status', 'createdAt', 'updatedAt', 'reviewedAt', 'reviewedBy', 'eventScope',
               'analysisType', 'analysisSubject', 'youtubeUrl', 'docsUrl', 'coverUrl'
             ])
             && data.keys().hasAll([
               'title', 'game', 'content', 'source', 'authorId', 'authorName',
               'status', 'createdAt'
             ])
             && data.title is string && data.title.size() > 0 && data.title.size() <= 120
             && data.game is string && data.game.size() > 0 && data.game.size() <= 60
             && data.content is string && data.content.size() > 0 && data.content.size() <= 6000
             && data.source is string && data.source.size() <= 500
             && (data.source.size() == 0 || data.source.matches('^https://.*'))
             && data.authorId is string && data.authorId.size() > 0 && data.authorId.size() <= 128
             && data.authorName is string && data.authorName.size() > 0 && data.authorName.size() <= 40
             && (!data.keys().hasAny(['anonymous']) || data.anonymous is bool)
             && (!data.keys().hasAny(['anonymous']) || data.anonymous != true || data.authorName == 'Anonymous')
             && data.status in ['pending', 'published', 'rejected']
             && data.createdAt is int
             && (!data.keys().hasAny(['updatedAt']) || data.updatedAt is int)
             && (!data.keys().hasAny(['reviewedAt']) || data.reviewedAt is int)
             && (!data.keys().hasAny(['reviewedBy']) || data.reviewedBy is string)
             && (!data.keys().hasAny(['eventScope']) || data.eventScope in ['ewc', 'region', 'random'])
             && (!data.keys().hasAny(['analysisType']) || data.analysisType in ['event', 'team', 'game', 'match'])
             && (!data.keys().hasAny(['analysisSubject']) || (data.analysisSubject is string && data.analysisSubject.size() <= 80))
             && (!data.keys().hasAny(['youtubeUrl']) || (data.youtubeUrl is string && data.youtubeUrl.size() <= 500 && (data.youtubeUrl.size() == 0 || data.youtubeUrl.matches('^https://.*'))))
             && (!data.keys().hasAny(['docsUrl']) || (data.docsUrl is string && data.docsUrl.size() <= 500 && (data.docsUrl.size() == 0 || data.docsUrl.matches('^https://.*'))))
             && (!data.keys().hasAny(['coverUrl'])
                 || data.coverUrl.size() == 0
                 || isSafeImageUrl(data.coverUrl, 2000));
    }

    function validBlogPrivate(data) {
      return data.keys().hasOnly(['authorId', 'requesterName', 'anonymous', 'createdAt'])
             && data.keys().hasAll(['authorId', 'requesterName', 'anonymous', 'createdAt'])
             && data.authorId is string && data.authorId.size() > 0 && data.authorId.size() <= 128
             && data.requesterName is string && data.requesterName.size() > 0 && data.requesterName.size() <= 40
             && data.anonymous is bool
             && data.createdAt is int;
    }

    function validArchiveSubmission(data) {
      return data.keys().hasOnly([
               'tournament', 'game', 'eventDate', 'winner', 'runnerUp', 'mvp',
               'source', 'submitterId', 'submitterName', 'status', 'createdAt',
               'reviewedAt', 'reviewedBy', 'archiveEntryId', 'eventScope'
             ])
             && data.keys().hasAll([
               'tournament', 'game', 'eventDate', 'winner', 'runnerUp', 'mvp',
               'source', 'submitterId', 'submitterName', 'status', 'createdAt'
             ])
             && data.tournament is string && data.tournament.size() > 0 && data.tournament.size() <= 120
             && data.game is string && data.game.size() > 0 && data.game.size() <= 60
             && data.eventDate is string && data.eventDate.size() > 0 && data.eventDate.size() <= 40
             && data.winner is string && data.winner.size() > 0 && data.winner.size() <= 100
             && data.runnerUp is string && data.runnerUp.size() <= 100
             && data.mvp is string && data.mvp.size() <= 100
             && data.source is string && data.source.size() <= 500
             && (data.source.size() == 0 || data.source.matches('^https://.*'))
             && data.submitterId is string && data.submitterId.size() > 0 && data.submitterId.size() <= 128
             && data.submitterName is string && data.submitterName.size() <= 40
             && data.status in ['pending', 'approved', 'rejected']
             && data.createdAt is int
             && (!data.keys().hasAny(['reviewedAt']) || data.reviewedAt is int)
             && (!data.keys().hasAny(['reviewedBy']) || data.reviewedBy is string)
             && (!data.keys().hasAny(['archiveEntryId']) || (data.archiveEntryId is string && data.archiveEntryId.size() <= 128))
             && (!data.keys().hasAny(['eventScope']) || data.eventScope in ['ewc', 'region', 'random']);
    }

    function validArchiveEntry(data) {
      return data.keys().hasOnly([

               'tournament', 'game', 'eventDate', 'winner', 'runnerUp', 'mvp',
               'source', 'createdAt', 'createdBy', 'submissionId', 'blogPostId', 'eventScope'
             ])
             && data.keys().hasAll([
               'tournament', 'game', 'eventDate', 'winner', 'runnerUp', 'mvp',
               'source', 'createdAt', 'createdBy'
             ])
             && data.tournament is string && data.tournament.size() > 0 && data.tournament.size() <= 120
             && data.game is string && data.game.size() > 0 && data.game.size() <= 60
             && data.eventDate is string && data.eventDate.size() > 0 && data.eventDate.size() <= 40
             && data.winner is string && data.winner.size() > 0 && data.winner.size() <= 100
             && data.runnerUp is string && data.runnerUp.size() <= 100
             && data.mvp is string && data.mvp.size() <= 100
             && data.source is string && data.source.size() <= 500
             && (data.source.size() == 0 || data.source.matches('^https://.*'))
             && data.createdAt is int
             && data.createdBy == request.auth.uid
             && (!data.keys().hasAny(['submissionId']) || (data.submissionId is string && data.submissionId.size() <= 128))
             && (!data.keys().hasAny(['blogPostId']) || (data.blogPostId is string && data.blogPostId.size() <= 128))
             && (!data.keys().hasAny(['eventScope']) || data.eventScope in ['ewc', 'region', 'random']);
    }

    function validStaffAction(data) {
      return data.keys().hasOnly(['action', 'targetType', 'targetId', 'targetLabel', 'actorUid', 'actorName', 'summary', 'createdAt'])
             && data.keys().hasAll(['action', 'targetType', 'targetId', 'targetLabel', 'actorUid', 'actorName', 'summary', 'createdAt'])
             && data.action in [
               'blog_published', 'blog_declined', 'blog_edited', 'blog_deleted',
               'archive_imported', 'archive_request_approved', 'archive_request_rejected',
               'blog_added_to_archive', 'report_reviewed', 'popup_saved', 'popup_deleted',
             'support_granted', 'support_revoked', 'support_permissions_updated',
               'player_banned', 'player_unbanned',
               'player_restricted', 'player_unrestricted', 'support_change_approved', 'support_change_denied'
             ]
             && data.targetType in ['blog', 'archive', 'archiveSubmission', 'archiveEntry', 'report', 'popup', 'support', 'player', 'supportChange']
             && data.targetId is string && data.targetId.size() > 0 && data.targetId.size() <= 128
             && data.targetLabel is string && data.targetLabel.size() <= 120
             && data.actorUid == request.auth.uid
             && data.actorName is string && data.actorName.size() <= 40
             && data.summary is string && data.summary.size() > 0 && data.summary.size() <= 240
             && data.createdAt is int;
    }

    function validTournament(data, strictKeys) {
      return (!strictKeys || data.keys().hasOnly([
               'name', 'game', 'format', 'startDate', 'endDate', 'artwork',
               'prizeAmount', 'prizeCurrency', 'registrationOpen',
               'adminUserId', 'adminDisplayName', 'coAdminUserIds', 'coAdminPlayerTags', 'status',
               'isLegacyImport', 'createdAt', 'updatedAt', 'results', 'archived', 'archivedAt',
               'kind', 'joinMode', 'maxSlots', 'blurb', 'posterUrl', 'publicStats',
               'region', 'rankBand'
             ]))
             && data.name is string && data.name.size() > 0 && data.name.size() <= 120
             && data.game is string && data.game.size() <= 60
             && data.format is string && data.format.size() <= 60
             && data.adminUserId is string

             && (!data.keys().hasAny(['startDate']) || (data.startDate is string && data.startDate.size() <= 40))
             && (!data.keys().hasAny(['endDate']) || (data.endDate is string && data.endDate.size() <= 40))
             && (!data.keys().hasAny(['artwork']) || (data.artwork is string && data.artwork.size() <= 500))
             && (!data.keys().hasAny(['adminDisplayName']) || (data.adminDisplayName is string && data.adminDisplayName.size() <= 40))
             && data.coAdminUserIds is list && data.coAdminUserIds.size() <= 20
             && (!data.keys().hasAny(['coAdminPlayerTags']) || (data.coAdminPlayerTags is map && data.coAdminPlayerTags.keys().size() <= 20 && data.coAdminPlayerTags.keys().hasOnly(data.coAdminUserIds)))
             && data.status in ['upcoming', 'live', 'completed', 'closed']
             && (!data.keys().hasAny(['kind']) || data.kind in ['bracket', 'custom_room'])
             && (!data.keys().hasAny(['joinMode']) || data.joinMode in ['request', 'open'])
             && (!data.keys().hasAny(['maxSlots']) || (data.maxSlots is int && data.maxSlots >= 0 && data.maxSlots <= 256))
             && (!data.keys().hasAny(['blurb']) || (data.blurb is string && data.blurb.size() <= 400))
             && (!data.keys().hasAny(['region']) || (data.region is string && data.region.size() <= 40))
             && (!data.keys().hasAny(['rankBand']) || (data.rankBand is string && data.rankBand.size() <= 40))
             && (!data.keys().hasAny(['posterUrl'])
                 || data.posterUrl.size() == 0
                 || isSafeImageUrl(data.posterUrl, 450000))
             && (!data.keys().hasAny(['publicStats']) || data.publicStats is bool)
             && (!data.keys().hasAny(['isLegacyImport']) || data.isLegacyImport is bool)
             && (!data.keys().hasAny(['createdAt']) || data.createdAt is int)
             && (!data.keys().hasAny(['updatedAt']) || data.updatedAt is int)
             && (!data.keys().hasAny(['archived']) || data.archived is bool)
             && (!data.keys().hasAny(['archivedAt']) || data.archivedAt is int)
             && (!data.keys().hasAny(['prizeAmount'])
                 || ((data.prizeAmount is int || data.prizeAmount is float)
                     && data.prizeAmount >= 0 && data.prizeAmount <= 100000000))
             && (!data.keys().hasAny(['prizeCurrency'])
                 || (data.prizeCurrency is string && data.prizeCurrency == 'INR'))
             && (!data.keys().hasAny(['registrationOpen']) || data.registrationOpen is bool)
             && (!data.keys().hasAny(['results'])
                 || (data.results is map
                     && data.results.keys().hasOnly(['winner', 'mvp', 'runnerUp', 'secondRunnerUp'])
                     && data.results.winner is string && data.results.winner.size() <= 80
                     && data.results.mvp is string && data.results.mvp.size() <= 80
                     && data.results.runnerUp is string && data.results.runnerUp.size() <= 80
                     && data.results.secondRunnerUp is string && data.results.secondRunnerUp.size() <= 80));
    }

    function isApprovedOnTournament(tid) {
      return isActiveSiteUser()
             && exists(/databases/$(database)/documents/tournaments/$(tid)/registrations/$(request.auth.uid))
             && get(/databases/$(database)/documents/tournaments/$(tid)/registrations/$(request.auth.uid)).data.status == 'approved';
    }

    function canReadScrimDetails(tid) {
      let t = parent(tid);
      return isAdmin(t)
             || (t.keys().hasAny(['joinMode']) && t.joinMode == 'open')
             || (t.keys().hasAny(['publicStats']) && t.publicStats == true)
             || isApprovedOnTournament(tid);
    }

    function canReadScrimLobby(tid) {
      let t = parent(tid);
      return isAdmin(t)
             || (isActiveSiteUser() && t.keys().hasAny(['joinMode']) && t.joinMode == 'open')
             || isApprovedOnTournament(tid);
    }

    function validTeam(data) {
      return data.keys().hasOnly(['name', 'tag'])
             && data.name is string && data.name.size() > 0 && data.name.size() <= 80
             && data.tag is string && data.tag.size() <= 5;
    }

    function validMatch(data) {
      return data.keys().hasOnly(['teamAId', 'teamBId', 'round', 'date', 'scoreA', 'scoreB', 'status'])
             && data.keys().hasAll(['teamAId', 'teamBId', 'round', 'date', 'scoreA', 'scoreB', 'status'])
             && data.teamAId is string && data.teamAId.size() <= 128
             && data.teamBId is string && data.teamBId.size() <= 128
             && data.teamAId != data.teamBId
             && data.round is string && data.round.size() <= 60
             && data.date is string && data.date.size() <= 40
             && (data.scoreA is int || data.scoreA is float) && data.scoreA >= 0 && data.scoreA <= 1000000
             && (data.scoreB is int || data.scoreB is float) && data.scoreB >= 0 && data.scoreB <= 1000000
             && data.status in ['upcoming', 'live', 'completed'];
    }

    function validStat(data) {
      return data.keys().hasOnly(['player', 'teamId', 'matchId', 'kills', 'deaths', 'assists', 'score'])
             && data.keys().hasAll(['player', 'teamId', 'matchId', 'kills', 'deaths', 'assists', 'score'])
             && data.player is string && data.player.size() > 0 && data.player.size() <= 100
             && (data.teamId == null || (data.teamId is string && data.teamId.size() <= 128))

             && (data.matchId == null || (data.matchId is string && data.matchId.size() <= 128))
             && (data.kills is int || data.kills is float) && data.kills >= 0 && data.kills <= 1000000
             && (data.deaths is int || data.deaths is float) && data.deaths >= 0 && data.deaths <= 1000000
             && (data.assists is int || data.assists is float) && data.assists >= 0 && data.assists <= 1000000
             && (data.score is int || data.score is float) && data.score >= 0 && data.score <= 100000000;
    }

    match /tournaments/{tid} {
      allow read: if canBrowsePublicData();

      allow create: if isActiveSiteUser()
                    && accountSettled()
                    && !isSiteRestricted()
                    && request.resource.data.adminUserId == request.auth.uid
                    && request.resource.data.coAdminUserIds is list
                    && request.resource.data.coAdminUserIds.size() == 0
                    && validTournament(request.resource.data, true);

      allow update: if isAdmin(resource.data)
                    && request.resource.data.adminUserId == resource.data.adminUserId
                    && (request.resource.data.coAdminUserIds == resource.data.coAdminUserIds
                        || isOwner(resource.data))
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['coAdminUserIds', 'coAdminPlayerTags', 'updatedAt', 'results', 'status', 'registrationOpen', 'archived', 'archivedAt', 'joinMode', 'maxSlots', 'kind', 'blurb', 'posterUrl', 'publicStats', 'region', 'rankBand'])
                    && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['coAdminPlayerTags']) || isOwner(resource.data))
                    && validTournament(request.resource.data, false);

      allow delete: if isOwner(resource.data);

      match /teams/{id} {
        allow read: if canBrowsePublicData() && canReadScrimDetails(tid);
        allow create: if isAdmin(parent(tid)) && validTeam(request.resource.data);
        allow update: if isAdmin(parent(tid)) && validTeam(request.resource.data);
        allow delete: if isAdmin(parent(tid));
      }
      match /matches/{id} {
        allow read: if canBrowsePublicData() && canReadScrimDetails(tid);
        allow create: if isAdmin(parent(tid)) && validMatch(request.resource.data);
        allow update: if isAdmin(parent(tid))
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['scoreA', 'scoreB', 'status'])
                      && (request.resource.data.scoreA is int || request.resource.data.scoreA is float)
                      && request.resource.data.scoreA >= 0 && request.resource.data.scoreA <= 1000000
                      && (request.resource.data.scoreB is int || request.resource.data.scoreB is float)
                      && request.resource.data.scoreB >= 0 && request.resource.data.scoreB <= 1000000
                      && request.resource.data.status in ['upcoming', 'live', 'completed'];
        allow delete: if isAdmin(parent(tid));
      }
      match /stats/{id} {
        allow read: if canBrowsePublicData() && canReadScrimDetails(tid);
        allow create: if isAdmin(parent(tid)) && validStat(request.resource.data);
        allow update: if isAdmin(parent(tid)) && validStat(request.resource.data);
        allow delete: if isAdmin(parent(tid));
      }


      match /lobby/{docId} {
        allow read: if canReadScrimLobby(tid);
        allow create, update: if docId == 'credentials'
                              && isAdmin(parent(tid))
                              && request.resource.data.keys().hasOnly(['roomId', 'roomPassword', 'updatedAt'])
                              && request.resource.data.roomId is string
                              && request.resource.data.roomId.size() > 0
                              && request.resource.data.roomId.size() <= 40
                              && request.resource.data.roomPassword is string
                              && request.resource.data.roomPassword.size() > 0
                              && request.resource.data.roomPassword.size() <= 40
                              && request.resource.data.updatedAt is int;
        allow delete: if docId == 'credentials' && isAdmin(parent(tid));
      }

      match /registrations/{playerId} {
        allow read: if isAdmin(parent(tid))
                    || (isActiveSiteUser() && request.auth.uid == resource.data.playerId);
        allow create: if isActiveSiteUser()
                      && exists(/databases/$(database)/documents/tournaments/$(tid))
                      && (!parent(tid).keys().hasAny(['registrationOpen'])
                          || parent(tid).registrationOpen == true)
                      && (!parent(tid).keys().hasAny(['archived']) || parent(tid).archived != true)
                      && parent(tid).status != 'completed'
                      && parent(tid).status != 'closed'
                      && request.auth.uid == playerId
                      && request.resource.data.keys().hasOnly(['playerId', 'displayName', 'status', 'requestedAt'])
                      && request.resource.data.playerId == request.auth.uid
                      && request.resource.data.displayName is string
                      && request.resource.data.displayName.size() <= 40
                      && request.resource.data.requestedAt is int
                      && ((parent(tid).joinMode == 'open' && request.resource.data.status == 'approved')
                          || ((parent(tid).joinMode != 'open') && request.resource.data.status == 'pending'));
        allow update: if isAdmin(parent(tid))
                      && request.resource.data.diff(resource.data).affectedKeys()
                           .hasOnly(['status', 'reviewedAt', 'reviewedBy'])
                      && request.resource.data.status in ['approved', 'declined']
                      && request.resource.data.reviewedBy == request.auth.uid
                      && request.resource.data.reviewedAt is int;
        allow delete: if isAdmin(parent(tid));
      }
    }

    match /moderators/{userId} {
      allow get: if isActiveSiteUser() && request.auth.uid == userId;
      allow list, create, update, delete: if false;
    }

    function validSupportPermissions(data) {
      return data is map
             && data.keys().hasOnly([
                  'vaultEdit', 'vaultDelete', 'blogReview', 'archiveDecide', 'blogPromote',
                  'reportsTriage', 'libraryView', 'httpsPostersOnly',
                  'vaultEditMode', 'vaultDeleteMode', 'blogReviewMode', 'archiveDecideMode', 'blogPromoteMode'
                ])
             && data.keys().hasAll([
                  'vaultEdit', 'vaultDelete', 'blogReview', 'archiveDecide', 'blogPromote',
                  'reportsTriage', 'libraryView', 'httpsPostersOnly',
                  'vaultEditMode', 'vaultDeleteMode', 'blogReviewMode', 'archiveDecideMode', 'blogPromoteMode'
                ])
             && data.vaultEdit is bool
             && data.vaultDelete is bool
             && data.blogReview is bool
             && data.archiveDecide is bool
             && data.blogPromote is bool
             && data.reportsTriage is bool
             && data.libraryView is bool
             && data.httpsPostersOnly is bool
             && data.vaultEditMode in ['propose', 'direct']
             && data.vaultDeleteMode in ['propose', 'direct']
             && data.blogReviewMode in ['propose', 'direct']
             && data.archiveDecideMode in ['propose', 'direct']
             && data.blogPromoteMode in ['propose', 'direct'];
    }

    function supportPermDirect(uid, key) {
      return supportPerm(uid, key)
             && get(/databases/$(database)/documents/siteRoles/$(uid)).data.permissions[key + 'Mode'] == 'direct';
    }

    function supportPerm(uid, key) {
      return exists(/databases/$(database)/documents/siteRoles/$(uid))
             && get(/databases/$(database)/documents/siteRoles/$(uid)).data.role == 'support'
             && get(/databases/$(database)/documents/siteRoles/$(uid)).data.enabled == true
             && get(/databases/$(database)/documents/siteRoles/$(uid)).data.keys().hasAny(['permissions'])
             && get(/databases/$(database)/documents/siteRoles/$(uid)).data.permissions[key] == true;
    }

    // Legacy support docs without permissions keep prior full propose access except deletes stay opt-in.
    function supportCanAction(action) {
      return isSiteSupport()
             && (
               (action == 'cms_upsert' && (
                 !get(/databases/$(database)/documents/siteRoles/$(request.auth.uid)).data.keys().hasAny(['permissions'])
                 || supportPerm(request.auth.uid, 'vaultEdit')
               ))
               || (action == 'cms_delete' && supportPerm(request.auth.uid, 'vaultDelete'))
               || (action == 'blog_review' && (
                 !get(/databases/$(database)/documents/siteRoles/$(request.auth.uid)).data.keys().hasAny(['permissions'])
                 || supportPerm(request.auth.uid, 'blogReview')
               ))
               || (action == 'archive_decision' && (
                 !get(/databases/$(database)/documents/siteRoles/$(request.auth.uid)).data.keys().hasAny(['permissions'])
                 || supportPerm(request.auth.uid, 'archiveDecide')
               ))
               || (action == 'blog_promote' && (
                 !get(/databases/$(database)/documents/siteRoles/$(request.auth.uid)).data.keys().hasAny(['permissions'])
                 || supportPerm(request.auth.uid, 'blogPromote')
               ))
             );
    }

    match /siteRoles/{userId} {
      allow get: if request.auth != null && (request.auth.uid == userId || isSiteOwner());
      allow list: if isSiteOwner();
      allow create: if isSiteOwner()
                    && request.resource.data.keys().hasOnly(['role', 'enabled', 'updatedAt', 'permissions'])
                    && request.resource.data.keys().hasAll(['role', 'enabled', 'updatedAt', 'permissions'])
                    && request.resource.data.role == 'support'
                    && request.resource.data.enabled == true
                    && request.resource.data.updatedAt is int
                    && validSupportPermissions(request.resource.data.permissions);
      allow update: if isSiteOwner()
                    && resource.data.role == 'support'
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['role', 'enabled', 'updatedAt', 'permissions'])
                    && request.resource.data.role == 'support'
                    && request.resource.data.enabled is bool
                    && request.resource.data.updatedAt is int
                    && (!request.resource.data.keys().hasAny(['permissions'])
                        || validSupportPermissions(request.resource.data.permissions));
      allow delete: if isSiteOwner() && resource.data.role == 'support';
    }


    match /sitePopups/{popupId} {
      allow get, list: if isActiveSiteUser() && (isSiteOwner() || resource.data.enabled == true);
      allow create: if isSiteOwner() && validSitePopup(request.resource.data);
      allow update: if isSiteOwner()
                    && validSitePopup(request.resource.data)
                    && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isSiteOwner();
    }

    match /blogPosts/{postId} {
      allow get, list: if (canBrowsePublicData() && resource.data.status == 'published')
                       || (isActiveSiteUser()
                           && (resource.data.authorId == request.auth.uid
                               || isSiteStaff() || isModerator()));
      allow create: if isActiveSiteUser()
                    && accountSettled()
                    && request.resource.data.authorId == request.auth.uid
                    && request.resource.data.status == 'pending'
                    && validBlogPost(request.resource.data)
                    && freshClientTimestamp(request.resource.data.createdAt)
                    && existsAfter(/databases/$(database)/documents/blogPrivate/$(postId))
                    && getAfter(/databases/$(database)/documents/blogPrivate/$(postId)).data.authorId == request.auth.uid
                    && (
                      (request.resource.data.keys().hasAny(['anonymous'])
                        && request.resource.data.anonymous == true
                        && getAfter(/databases/$(database)/documents/blogPrivate/$(postId)).data.anonymous == true)
                      ||
                      ((!request.resource.data.keys().hasAny(['anonymous']) || request.resource.data.anonymous == false)
                        && getAfter(/databases/$(database)/documents/blogPrivate/$(postId)).data.anonymous == false)
                    );
      allow update: if isActiveSiteUser()
                    && validBlogPost(request.resource.data)
                    && request.resource.data.authorId == resource.data.authorId
                    && request.resource.data.authorName == resource.data.authorName
                    && request.resource.data.createdAt == resource.data.createdAt
                    && ((!resource.data.keys().hasAny(['anonymous']) && !request.resource.data.keys().hasAny(['anonymous']))
                        || (resource.data.keys().hasAny(['anonymous'])
                            && request.resource.data.keys().hasAny(['anonymous'])
                            && request.resource.data.anonymous == resource.data.anonymous))
                    && (
                      (request.auth.uid == resource.data.authorId
                       && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                            'title', 'game', 'content', 'source', 'status', 'updatedAt', 'reviewedAt', 'reviewedBy',
                            'eventScope', 'analysisType', 'analysisSubject', 'youtubeUrl', 'docsUrl', 'coverUrl'
                          ])
                       && request.resource.data.status == 'pending')
                      ||
                      ((isSiteStaff() || isModerator())
                       && request.resource.data.status == 'pending'
                       && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                            'title', 'game', 'content', 'source', 'status', 'updatedAt', 'reviewedAt', 'reviewedBy',
                            'eventScope', 'analysisType', 'analysisSubject', 'youtubeUrl', 'docsUrl', 'coverUrl'
                          ]))
                      ||
                      ((isSiteStaff() || isModerator())
                       && request.resource.data.status in ['published', 'rejected']
                       && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reviewedAt', 'reviewedBy'])
                       && request.resource.data.reviewedAt is int
                       && request.resource.data.reviewedBy == request.auth.uid)
                    );
      allow delete: if isActiveSiteUser()
                    && (resource.data.authorId == request.auth.uid || isSiteStaff() || isModerator());
    }

    // Staff / author-only identity for anonymous blog requests (not guest-readable).
    match /blogPrivate/{postId} {
      allow get, list: if isSiteStaff() || isModerator()
                       || (isActiveSiteUser() && resource.data.authorId == request.auth.uid);
      allow create: if isActiveSiteUser()
                    && accountSettled()
                    && request.resource.data.authorId == request.auth.uid
                    && validBlogPrivate(request.resource.data)
                    && freshClientTimestamp(request.resource.data.createdAt)
                    && existsAfter(/databases/$(database)/documents/blogPosts/$(postId))
                    && getAfter(/databases/$(database)/documents/blogPosts/$(postId)).data.authorId == request.auth.uid;
      allow update: if false;
      allow delete: if isSiteStaff() || isModerator()
                    || (isActiveSiteUser() && resource.data.authorId == request.auth.uid);
    }

    match /archiveSubmissions/{submissionId} {
      allow get, list: if isSiteStaff()
                       || (isActiveSiteUser() && resource.data.submitterId == request.auth.uid);
      allow create: if isActiveSiteUser()
                    && accountSettled()
                    && request.resource.data.submitterId == request.auth.uid
                    && request.resource.data.status == 'pending'
                    && validArchiveSubmission(request.resource.data)
                    && freshClientTimestamp(request.resource.data.createdAt);
      allow update: if isSiteStaff()
                    && resource.data.status == 'pending'
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reviewedAt', 'reviewedBy', 'archiveEntryId'])
                    && validArchiveSubmission(request.resource.data)
                    && request.resource.data.status in ['approved', 'rejected']
                    && request.resource.data.reviewedBy == request.auth.uid
                    && request.resource.data.reviewedAt is int
                    && (request.resource.data.status == 'rejected'
                        || (request.resource.data.archiveEntryId is string
                            && getAfter(/databases/$(database)/documents/esportsArchive/$(request.resource.data.archiveEntryId)).data.submissionId == submissionId));
      allow delete: if false;
    }

    match /staffActions/{actionId} {
      allow get, list: if isSiteOwner();
      allow create: if isActiveSiteUser()
                    && (isSiteStaff() || isModerator())
                    && validStaffAction(request.resource.data);
      allow update, delete: if false;
    }

    match /reports/{reportId} {
      allow create: if isActiveSiteUser()
                    && accountSettled()
                    && validReport(request.resource.data)
                    && freshClientTimestamp(request.resource.data.createdAt)
                    && reportId == request.auth.uid + '_' + request.resource.data.targetType
                         + '_' + request.resource.data.targetId;
      allow get, list: if isSiteStaff();
      allow update: if (isSiteOwner()
                        || (isSiteSupport()
                            && (
                              !get(/databases/$(database)/documents/siteRoles/$(request.auth.uid)).data.keys().hasAny(['permissions'])
                              || supportPerm(request.auth.uid, 'reportsTriage')
                            )))
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['status', 'reviewedAt'])
                    && request.resource.data.status in ['reviewing', 'closed', 'archived']
                    && request.resource.data.reviewedAt is int;
      allow delete: if false;
    }

    match /friendRequests/{requestId} {
      allow read: if isActiveSiteUser()
                  && (resource.data.requesterId == request.auth.uid
                      || resource.data.recipientId == request.auth.uid);
      allow create: if isActiveSiteUser()
                    && accountSettled()
                    && request.resource.data.keys().hasOnly(['requesterId', 'requesterName', 'recipientId', 'recipientName', 'status', 'createdAt'])
                    && request.resource.data.requesterId == request.auth.uid
                    && request.resource.data.recipientId is string
                    && request.resource.data.recipientId != request.auth.uid
                    && requestId == request.auth.uid + '_' + request.resource.data.recipientId
                    && request.resource.data.requesterName is string
                    && request.resource.data.requesterName.size() <= 40
                    && (!request.resource.data.keys().hasAny(['recipientName']) || (request.resource.data.recipientName is string && request.resource.data.recipientName.size() <= 40))
                    && request.resource.data.status == 'pending'
                    && !isSiteRestricted()
                    && !isBlocked(request.auth.uid, request.resource.data.recipientId)
                    && freshClientTimestamp(request.resource.data.createdAt);
      allow update: if isActiveSiteUser()
                    && (
                      (resource.data.recipientId == request.auth.uid
                       && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reviewedAt'])
                       && request.resource.data.status in ['accepted', 'declined']
                       && request.resource.data.reviewedAt is int
                       && (request.resource.data.status != 'accepted' || !isBlocked(resource.data.requesterId, resource.data.recipientId)))
                      || (resource.data.status == 'accepted'
                          && request.auth.uid in [resource.data.requesterId, resource.data.recipientId]
                          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reviewedAt'])
                          && request.resource.data.status == 'removed'
                          && request.resource.data.reviewedAt is int)
                    );
      allow delete: if false;
    }

    match /userBlocks/{blockId} {
      allow get, list: if isActiveSiteUser()
        && request.auth.uid in [resource.data.blockerUid, resource.data.blockedUid];
      allow create: if isActiveSiteUser()
        && request.resource.data.keys().hasOnly(['blockerUid', 'blockedUid', 'blockedName', 'createdAt'])
        && request.resource.data.keys().hasAll(['blockerUid', 'blockedUid', 'blockedName', 'createdAt'])
        && request.resource.data.blockerUid == request.auth.uid
        && request.resource.data.blockedUid is string
        && request.resource.data.blockedUid != request.auth.uid
        && request.resource.data.blockedUid.size() <= 128
        && blockId == request.auth.uid + '_' + request.resource.data.blockedUid
        && isAcceptedFriend(request.auth.uid, request.resource.data.blockedUid)
        && request.resource.data.blockedName is string
        && request.resource.data.blockedName.size() <= 40
        && request.resource.data.createdAt is int;
      allow update: if false;
      allow delete: if isActiveSiteUser() && resource.data.blockerUid == request.auth.uid;
    }

    match /tournamentInvites/{inviteId} {
      allow get, list: if isActiveSiteUser()
        && (resource.data.inviteeUid == request.auth.uid || resource.data.invitedBy == request.auth.uid);
      allow create: if isActiveSiteUser()
        && request.resource.data.keys().hasOnly(['tournamentId', 'tournamentName', 'game', 'invitedBy', 'inviterName', 'inviteeUid', 'inviteeName', 'status', 'createdAt'])
        && request.resource.data.keys().hasAll(['tournamentId', 'tournamentName', 'game', 'invitedBy', 'inviterName', 'inviteeUid', 'inviteeName', 'status', 'createdAt'])
        && request.resource.data.tournamentId is string && request.resource.data.tournamentId.size() > 0 && request.resource.data.tournamentId.size() <= 128
        && inviteId == request.resource.data.tournamentId + '_' + request.resource.data.inviteeUid
        && request.resource.data.tournamentName is string && request.resource.data.tournamentName.size() > 0 && request.resource.data.tournamentName.size() <= 120
        && request.resource.data.game is string && request.resource.data.game.size() <= 60
        && request.resource.data.invitedBy == request.auth.uid
        && request.resource.data.inviterName is string && request.resource.data.inviterName.size() <= 40
        && request.resource.data.inviteeUid is string && request.resource.data.inviteeUid != request.auth.uid && request.resource.data.inviteeUid.size() <= 128
        && request.resource.data.inviteeName is string && request.resource.data.inviteeName.size() <= 40
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt is int
        && exists(/databases/$(database)/documents/tournaments/$(request.resource.data.tournamentId))
        && parent(request.resource.data.tournamentId).status != 'completed'
        && parent(request.resource.data.tournamentId).registrationOpen == true
        && (!parent(request.resource.data.tournamentId).keys().hasAny(['archived']) || parent(request.resource.data.tournamentId).archived != true)
        && isAcceptedFriend(request.auth.uid, request.resource.data.inviteeUid);
      allow update: if isActiveSiteUser()
        && ((resource.data.inviteeUid == request.auth.uid
             && resource.data.status == 'pending'
             && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'respondedAt'])
             && request.resource.data.status in ['accepted', 'declined']
             && request.resource.data.respondedAt is int)
            || (resource.data.invitedBy == request.auth.uid
                && resource.data.status == 'declined'
                && exists(/databases/$(database)/documents/tournaments/$(resource.data.tournamentId))
                && parent(resource.data.tournamentId).registrationOpen == true
                && (!parent(resource.data.tournamentId).keys().hasAny(['archived']) || parent(resource.data.tournamentId).archived != true)
                && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'createdAt', 'inviterName', 'inviteeName'])
                && request.resource.data.status == 'pending'
                && request.resource.data.createdAt is int
                && request.resource.data.inviterName is string && request.resource.data.inviterName.size() <= 40
                && request.resource.data.inviteeName is string && request.resource.data.inviteeName.size() <= 40));
      allow delete: if false;
    }

    function isEpochMs(value) {
      return (value is int || value is float) && value > 1000000000000 && value < 2000000000000;
    }

    match /conversations/{conversationId} {
      function validConversation(data) {
        return data.keys().hasOnly(['participants', 'createdAt'])
          && data.keys().hasAll(['participants', 'createdAt'])
          && data.participants is list && data.participants.size() == 2
          && data.participants[0] is string && data.participants[1] is string
          && data.participants[0] < data.participants[1]
          && conversationId == data.participants[0] + '_' + data.participants[1]
          && request.auth.uid in data.participants
          && isAcceptedFriend(data.participants[0], data.participants[1])
          && isEpochMs(data.createdAt);
      }
      allow get: if isActiveSiteUser() && (
        resource == null
        || (request.auth.uid in resource.data.participants
            && !isBlocked(resource.data.participants[0], resource.data.participants[1]))
      );
      allow list: if isActiveSiteUser() && request.auth.uid in resource.data.participants
        && !isBlocked(resource.data.participants[0], resource.data.participants[1]);
      allow create: if isActiveSiteUser() && validConversation(request.resource.data);
      allow update, delete: if false;

      match /messages/{messageId} {
        function parentConversation() {
          return get(/databases/$(database)/documents/conversations/$(conversationId)).data;
        }
        allow get, list: if isActiveSiteUser()
          && exists(/databases/$(database)/documents/conversations/$(conversationId))
          && request.auth.uid in parentConversation().participants
          && !isBlocked(parentConversation().participants[0], parentConversation().participants[1]);
        allow create: if isActiveSiteUser()
          && exists(/databases/$(database)/documents/conversations/$(conversationId))
          && request.auth.uid in parentConversation().participants
          && !isBlocked(parentConversation().participants[0], parentConversation().participants[1])
          && request.resource.data.keys().hasOnly(['senderId', 'text', 'createdAt'])
          && request.resource.data.keys().hasAll(['senderId', 'text', 'createdAt'])
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 1000
          && isEpochMs(request.resource.data.createdAt)
          && freshClientTimestamp(request.resource.data.createdAt);
        allow update, delete: if false;
      }
    }

    match /siteBans/{userId} {
      allow get: if request.auth != null && (request.auth.uid == userId || isSiteStaff());
      allow list: if isSiteStaff();
      // Ban records are written only by the trusted Cloud Function.
      allow create, update, delete: if false;
    }

    match /esportsArchive/{entryId} {
      allow read: if canBrowsePublicData();
      allow create: if (isSiteStaff() || isModerator())
                    && validArchiveEntry(request.resource.data);
      allow update, delete: if isModerator();
    }

    match /handles/{handleId} {
      // Public get is for ID uniqueness only — never store emails on new handle docs.
      allow get: if canBrowsePublicData();
      allow list: if false;
      allow create: if isActiveSiteUser()
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.keys().hasOnly(['uid', 'handle', 'createdAt'])
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.handle is string
                    && request.resource.data.handle.matches('^[a-z0-9_]{3,16}#[0-9]{4}$|^[a-z0-9_]{3,16}#[0-9]{8}$')
                    && handleId.matches('^[a-z0-9_]{3,16}::[0-9]{4}$|^[a-z0-9_]{3,16}::[0-9]{8}$')
                    && request.resource.data.handle == handleId.replace('::', '#')
                    && freshClientTimestamp(request.resource.data.createdAt);
      allow update: if false;
      allow delete: if isActiveSiteUser() && resource.data.uid == request.auth.uid;
    }

    match /players/{userId} {
      allow get: if isActiveSiteUser()
                 && (request.auth.uid == userId || resource.data.discoverable == true);

      allow list: if isActiveSiteUser()
                  && resource.data.discoverable == true;

      allow create: if isActiveSiteUser()
                    && request.auth.uid == userId
                    && !request.resource.data.keys().hasAny(['playerTag'])
                    && !request.resource.data.keys().hasAny(['handle'])
                    && validPlayerProfile(request.resource.data);
      allow update: if isActiveSiteUser()
                    && request.auth.uid == userId
                    && (!isSiteRestricted() || request.resource.data.discoverable == false)
                    && validPlayerProfile(request.resource.data)
                    && playerUsernameChangeAllowed()
                    && playerUsernameChangeCountConsistent()
                    && (!request.resource.data.keys().hasAny(['playerTag'])
                        || (request.resource.data.playerTag.matches('^[0-9]{4}$|^[0-9]{8}$')
                            && exists(/databases/$(database)/documents/handles/$(request.resource.data.displayName.lower() + '::' + request.resource.data.playerTag))
                            && get(/databases/$(database)/documents/handles/$(request.resource.data.displayName.lower() + '::' + request.resource.data.playerTag)).data.uid == request.auth.uid));

      allow delete: if isActiveSiteUser() && request.auth.uid == userId;
    }

    match /circuitCms/{recordId} {
      allow get, list: if canBrowsePublicData();
      allow create, update: if isSiteOwner()
                           || supportPermDirect(request.auth.uid, 'vaultEdit');
      allow delete: if isSiteOwner()
                    || supportPermDirect(request.auth.uid, 'vaultDelete');
    }

    // Agent-extracted matches: staff can read; only owner approves/writes one match at a time.
    match /liveMatrix/{matchId} {
      allow get, list: if isSiteStaff();
      allow create, update, delete: if isSiteOwner();
    }

    match /liveMatrixDecisions/{matchId} {
      allow get, list: if isSiteStaff();
      allow create, update, delete: if isSiteOwner();
    }

    match /siteSettings/{docId} {
      allow get: if (docId == 'deskGate' && isSiteStaff())
                 || (docId == 'features' && canBrowsePublicData());
      allow create, update: if
        (isSiteOwner()
         && docId == 'deskGate'
         && request.resource.data.keys().hasOnly(['ownerHash', 'supportHash', 'updatedAt', 'updatedBy'])
         && request.resource.data.keys().hasAll(['ownerHash', 'supportHash', 'updatedAt'])
         && request.resource.data.ownerHash is string
         && request.resource.data.ownerHash.size() <= 128
         && request.resource.data.supportHash is string
         && request.resource.data.supportHash.size() <= 128
         && request.resource.data.updatedAt is int
         && (!request.resource.data.keys().hasAny(['updatedBy'])
             || (request.resource.data.updatedBy is string
                 && request.resource.data.updatedBy == request.auth.uid)))
        || (isSiteStaff()
            && docId == 'features'
            && request.resource.data.keys().hasOnly(['digestControlsEnabled', 'updatedAt', 'updatedBy'])
            && request.resource.data.keys().hasAll(['digestControlsEnabled', 'updatedAt'])
            && request.resource.data.digestControlsEnabled is bool
            && request.resource.data.updatedAt is int
            && (!request.resource.data.keys().hasAny(['updatedBy'])
                || (request.resource.data.updatedBy is string
                    && request.resource.data.updatedBy == request.auth.uid)));
      allow delete: if false;
    }

    function validMediaCollection(data) {
      return data.keys().hasOnly([
               'scope', 'kind', 'game', 'tournamentId', 'title', 'defaultUrl',
               'coverUrl', 'createdAt', 'updatedAt', 'createdBy', 'hiddenAssetIds', 'purgedAssetIds', 'generated'
             ])
             && data.scope in ['site', 'tournament']
             && data.kind in ['background', 'avatar', 'event', 'flyer', 'post', 'poster']
             && data.game is string && data.game.size() <= 60
             && data.tournamentId is string && data.tournamentId.size() <= 128
             && data.title is string && data.title.size() > 0 && data.title.size() <= 80
             && data.createdBy is string
             && data.createdAt is int
             && data.updatedAt is int
             && (!data.keys().hasAny(['defaultUrl'])
                 || data.defaultUrl.size() == 0
                 || isSafeImageUrl(data.defaultUrl, 2000))
             && (!data.keys().hasAny(['coverUrl'])
                 || data.coverUrl.size() == 0
                 || isSafeImageUrl(data.coverUrl, 450000))
             && (!data.keys().hasAny(['generated']) || data.generated is bool)
             && (!data.keys().hasAny(['hiddenAssetIds'])
                 || (data.hiddenAssetIds is list && data.hiddenAssetIds.size() <= 64))
             && (!data.keys().hasAny(['purgedAssetIds'])
                 || (data.purgedAssetIds is list && data.purgedAssetIds.size() <= 64))
             && (data.scope == 'site' || data.tournamentId.size() > 0);
    }

    function canManageMediaCollection(data) {
      return isSiteOwner()
             || (data.scope == 'tournament'
                 && data.tournamentId.size() > 0
                 && exists(/databases/$(database)/documents/tournaments/$(data.tournamentId))
                 && isAdmin(get(/databases/$(database)/documents/tournaments/$(data.tournamentId)).data));
    }

    function validMediaAsset(data) {
      return data.keys().hasOnly(['url', 'path', 'name', 'contentType', 'bytes', 'createdAt', 'createdBy', 'isDefault', 'trashed', 'trashedAt'])
             && isSafeImageUrl(data.url, 500000)
             && data.path is string && data.path.size() > 0 && data.path.size() <= 800
             && data.name is string && data.name.size() <= 200
             && freshClientTimestamp(data.createdAt)
             && data.createdBy is string
             && data.contentType is string
             && data.contentType.matches('image/.*')
             && (!data.keys().hasAny(['bytes']) || ((data.bytes is int || data.bytes is float) && data.bytes >= 0 && data.bytes <= 5000000))
             && (!data.keys().hasAny(['isDefault']) || data.isDefault is bool)
             && (!data.keys().hasAny(['trashed']) || data.trashed is bool)
             && (!data.keys().hasAny(['trashedAt']) || (data.trashedAt is int && data.trashedAt >= 0));
    }

    match /mediaCollections/{collectionId} {
      allow get, list: if canBrowsePublicData();
      allow create: if validMediaCollection(request.resource.data)
                    && request.resource.data.createdBy == request.auth.uid
                    && canManageMediaCollection(request.resource.data);
      allow update: if validMediaCollection(request.resource.data)
                    && request.resource.data.createdAt == resource.data.createdAt
                    && request.resource.data.createdBy == resource.data.createdBy
                    && request.resource.data.scope == resource.data.scope
                    && request.resource.data.tournamentId == resource.data.tournamentId
                    && canManageMediaCollection(resource.data);
      allow delete: if canManageMediaCollection(resource.data);

      match /assets/{assetId} {
        allow get, list: if canBrowsePublicData();
        allow create: if validMediaAsset(request.resource.data)
                      && request.resource.data.createdBy == request.auth.uid
                      && canManageMediaCollection(get(/databases/$(database)/documents/mediaCollections/$(collectionId)).data);
        allow update, delete: if canManageMediaCollection(get(/databases/$(database)/documents/mediaCollections/$(collectionId)).data);
      }
    }

    match /staffChangeRequests/{requestId} {
      allow create: if isSiteSupport()
                    && request.resource.data.status == 'pending'
                    && request.resource.data.actorUid == request.auth.uid
                    && request.resource.data.actorName is string
                    && request.resource.data.actorName.size() <= 40
                    && request.resource.data.action in ['cms_upsert', 'cms_delete', 'blog_review', 'archive_decision', 'blog_promote']
                    && supportCanAction(request.resource.data.action)
                    && request.resource.data.summary is string
                    && request.resource.data.summary.size() > 0
                    && request.resource.data.summary.size() <= 240
                    && request.resource.data.createdAt is int
                    && request.resource.data.payload is map
                    && (!request.resource.data.keys().hasAny(['targetType']) || (request.resource.data.targetType is string && request.resource.data.targetType.size() <= 40))
                    && (!request.resource.data.keys().hasAny(['targetId']) || (request.resource.data.targetId is string && request.resource.data.targetId.size() <= 128))
                    && (!request.resource.data.keys().hasAny(['targetLabel']) || (request.resource.data.targetLabel is string && request.resource.data.targetLabel.size() <= 120));
      allow get, list: if isSiteOwner()
                    || (isSiteSupport() && resource.data.actorUid == request.auth.uid);
      allow update: if isSiteOwner()
                    && resource.data.status == 'pending'
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['status', 'reviewedAt', 'reviewedBy', 'reviewNote'])
                    && request.resource.data.status in ['approved', 'denied']
                    && request.resource.data.reviewedAt is int
                    && request.resource.data.reviewedBy == request.auth.uid
                    && (!request.resource.data.keys().hasAny(['reviewNote']) || (request.resource.data.reviewNote is string && request.resource.data.reviewNote.size() <= 240));
      allow delete: if false;
    }

    match /userVaultBookmarks/{userId} {
      allow get: if isActiveSiteUser() && request.auth.uid == userId;
      allow list: if false;
      allow create, update: if isActiveSiteUser()
                            && request.auth.uid == userId
                            && request.resource.data.keys().hasOnly(['slugs', 'updatedAt'])
                            && request.resource.data.slugs is list
                            && request.resource.data.slugs.size() <= 80
                            && request.resource.data.updatedAt is int;
      allow delete: if isActiveSiteUser() && request.auth.uid == userId;
    }

    match /userPrefs/{userId} {
      allow get: if isActiveSiteUser() && request.auth.uid == userId;
      allow list: if false;
      allow create, update: if isActiveSiteUser()
                            && request.auth.uid == userId
                            && request.resource.data.keys().hasOnly(['showWeeklyPanel', 'digestOptIn', 'updatedAt'])
                            && request.resource.data.showWeeklyPanel is bool
                            && request.resource.data.digestOptIn is bool
                            && request.resource.data.updatedAt is int;
      allow delete: if isActiveSiteUser() && request.auth.uid == userId;
    }

    match /scoreline/shared-data {
      // No current app feature uses this legacy document; deny client access
      // until a specific, validated schema is introduced.
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}

