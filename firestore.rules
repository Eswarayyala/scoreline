rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(t) {
      return request.auth != null && request.auth.uid == t.adminUserId;
    }
    function isAdmin(t) {
      return request.auth != null && (
        request.auth.uid == t.adminUserId ||
        (t.coAdminUserIds is list && request.auth.uid in t.coAdminUserIds)
      );
    }
    function parent(tid) {
      return get(/databases/$(database)/documents/tournaments/$(tid)).data;
    }
    function isModerator() {
      return request.auth != null
        && exists(/databases/$(database)/documents/moderators/$(request.auth.uid))
        && get(/databases/$(database)/documents/moderators/$(request.auth.uid)).data.enabled == true;
    }
    function validPlayerProfile(data) {
      return data.keys().hasOnly([
               'displayName', 'games', 'region', 'language', 'style',
               'bio', 'avatar', 'discoverable', 'updatedAt'
             ])
             && data.keys().hasAll([
               'displayName', 'games', 'region', 'language', 'style',
               'bio', 'avatar', 'discoverable', 'updatedAt'
             ])
             && data.displayName is string
             && data.displayName.size() > 0
             && data.displayName.size() <= 40
             && data.games is list
             && data.games.size() <= 20
             && data.region is string
             && data.region.size() <= 60
             && data.language is string
             && data.language.size() <= 40
             && data.style is string
             && data.style.size() <= 60
             && data.bio is string
             && data.bio.size() <= 200
             && data.avatar is string
             && data.avatar.size() <= 16
             && data.discoverable is bool
             && data.updatedAt is int;
    }

    function validReport(data) {
      return data.keys().hasOnly([
               'reporterId', 'targetType', 'targetId', 'targetName',
               'reason', 'details', 'status', 'createdAt'
             ])
             && data.reporterId == request.auth.uid
             && data.targetType in ['player', 'tournament']
             && data.targetId is string
             && data.targetId.size() > 0
             && data.targetId.size() <= 128
             && data.targetName is string
             && data.targetName.size() <= 120
             && data.reason in ['Abuse or harassment', 'Scam or fraud', 'Inappropriate content', 'Other']
             && data.details is string
             && data.details.size() <= 1000
             && data.status == 'submitted'
             && data.createdAt is int;
    }

    match /tournaments/{tid} {
      allow read: if true;

      allow create: if request.auth != null
                    && request.resource.data.adminUserId == request.auth.uid
                    && request.resource.data.coAdminUserIds is list
                    && request.resource.data.coAdminUserIds.size() == 0;

      allow update: if isAdmin(resource.data)
                    && request.resource.data.adminUserId == resource.data.adminUserId
                    && (request.resource.data.coAdminUserIds == resource.data.coAdminUserIds
                        || isOwner(resource.data));

      allow delete: if isOwner(resource.data);

      match /teams/{id}   { allow read: if true; allow write: if isAdmin(parent(tid)); }
      match /matches/{id} { allow read: if true; allow write: if isAdmin(parent(tid)); }
      match /stats/{id}   { allow read: if true; allow write: if isAdmin(parent(tid)); }

      match /registrations/{playerId} {
        allow read: if isAdmin(parent(tid))
                    || (request.auth != null && request.auth.uid == resource.data.playerId);
        allow create: if request.auth != null
                      && request.auth.uid == playerId
                      && request.resource.data.keys().hasOnly(['playerId', 'displayName', 'status', 'requestedAt'])
                      && request.resource.data.playerId == request.auth.uid
                      && request.resource.data.displayName is string
                      && request.resource.data.displayName.size() <= 40
                      && request.resource.data.status == 'pending'
                      && request.resource.data.requestedAt is int;
        allow update: if isAdmin(parent(tid))
                      && request.resource.data.diff(resource.data).affectedKeys()
                           .hasOnly(['status', 'reviewedAt', 'reviewedBy'])
                      && request.resource.data.status in ['approved', 'declined']
                      && request.resource.data.reviewedBy == request.auth.uid
                      && request.resource.data.reviewedAt is int;
        allow delete: if isAdmin(parent(tid));
      }
    }

    match /moderators/{userId} {
      allow get: if request.auth != null && request.auth.uid == userId;
      allow list, create, update, delete: if false;
    }

    match /reports/{reportId} {
      allow create: if request.auth != null
                    && validReport(request.resource.data)
                    && reportId == request.auth.uid + '_' + request.resource.data.targetType
                         + '_' + request.resource.data.targetId;
      allow get, list: if isModerator();
      allow update: if isModerator()
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['status', 'reviewedAt'])
                    && request.resource.data.status in ['reviewing', 'closed']
                    && request.resource.data.reviewedAt is int;
      allow delete: if false;
    }

    match /friendRequests/{requestId} {
      allow read: if request.auth != null
                  && (resource.data.requesterId == request.auth.uid
                      || resource.data.recipientId == request.auth.uid);
      allow create: if request.auth != null
                    && request.resource.data.keys().hasOnly(['requesterId', 'requesterName', 'recipientId', 'status', 'createdAt'])
                    && request.resource.data.requesterId == request.auth.uid
                    && request.resource.data.recipientId is string
                    && request.resource.data.recipientId != request.auth.uid
                    && requestId == request.auth.uid + '_' + request.resource.data.recipientId
                    && request.resource.data.requesterName is string
                    && request.resource.data.requesterName.size() <= 40
                    && request.resource.data.status == 'pending'
                    && request.resource.data.createdAt is int;
      allow update: if request.auth != null
                    && resource.data.recipientId == request.auth.uid
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reviewedAt'])
                    && request.resource.data.status in ['accepted', 'declined']
                    && request.resource.data.reviewedAt is int;
      allow delete: if false;
    }

    match /esportsArchive/{entryId} {
      allow read: if true;
      allow create: if isModerator()
                    && request.resource.data.keys().hasOnly([
                         'tournament', 'game', 'eventDate', 'winner', 'runnerUp',
                         'mvp', 'source', 'createdAt', 'createdBy'
                       ])
                    && request.resource.data.tournament is string
                    && request.resource.data.tournament.size() <= 120
                    && request.resource.data.game is string
                    && request.resource.data.game.size() <= 60
                    && request.resource.data.eventDate is string
                    && request.resource.data.eventDate.size() <= 40
                    && request.resource.data.winner is string
                    && request.resource.data.winner.size() <= 100
                    && request.resource.data.runnerUp is string
                    && request.resource.data.runnerUp.size() <= 100
                    && request.resource.data.mvp is string
                    && request.resource.data.mvp.size() <= 100
                    && request.resource.data.source is string
                    && request.resource.data.source.size() <= 500
                    && request.resource.data.createdAt is int
                    && request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if isModerator();
    }

    match /players/{userId} {
      allow get: if request.auth != null
                 && (request.auth.uid == userId || resource.data.discoverable == true);

      allow list: if request.auth != null
                  && resource.data.discoverable == true;

      allow create, update: if request.auth != null
                            && request.auth.uid == userId
                            && validPlayerProfile(request.resource.data);

      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    match /scoreline/shared-data {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
